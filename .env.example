# --- Railway variables (set in the dashboard, never commit real values) ---
DASH_TOKEN=            # long random string; required because the dashboard is public
STATE_DIR=/data        # mount a Railway volume at /data (holds state + STOP file)
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60   # lets an in-flight swap finish on redeploy
# Paper mode (default): nothing else needed. The agent makes its own wallet in /data/wallet.json.
# Live mode only after weeks of paper results:
# AGENT_PRIVATE_KEY=0x...   # preferred over wallet.json on Railway
# LIVE=1
# LIVE_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
# LIVE_MAX_USD=100
# LIVE_MAX_TRADE_USD=25
# REGIME_DAYS=100   # BTC trend filter; REGIME=off disables it (not recommended)
# --- New-coin scanner (paper only) ---
# SCAN=off              # disable
# SCAN_MAX_MC=20000
# SCAN_MIN_LIQ=3000
# SCAN_BUDGET_USD=30
# SCAN_TRADE_USD=10
